---
// =====================================================
// FORMULAIRE DE CONTACT
// Le message est envoyé dans la collection "messages" de PocketBase,
// directement depuis le navigateur (script en bas du fichier).
// =====================================================
---
<div class="max-w-3xl mx-auto mt-16 bg-sable border-2 border-or-fonce p-2">
  <div class="border border-or px-6 md:px-24 py-14">
    <form id="formulaire-contact" class="flex flex-col gap-8">
      <div class="h-px bg-taupe/60"></div>
      <div class="grid md:grid-cols-2 gap-8">
        <label class="flex flex-col gap-2">
          <span class="font-semibold">Votre nom</span>
          <input type="text" name="nom" required placeholder="Madame ou Monsieur…" class="champ-souligne py-2">
        </label>
        <label class="flex flex-col gap-2">
          <span class="font-semibold">Votre email</span>
          <input type="email" name="email" required placeholder="monemail@…" class="champ-souligne py-2">
        </label>
      </div>
      <label class="flex flex-col gap-2">
        <span class="font-semibold">Votre message</span>
        <textarea name="message" required rows="6" placeholder="Sujet…" class="textarea w-full bg-[#FAEFCF] border-0 rounded-xl italic text-lg"></textarea>
      </label>
      <div class="h-px bg-taupe/60"></div>
      <button type="submit" class="btn btn-primary border-ocre self-center font-texte font-bold text-lg tracking-[0.1em] px-12">ENVOYER</button>
    </form>

    <!-- Message de confirmation ou d'erreur (rempli par le script) -->
    <div id="retour-formulaire" role="status" aria-live="polite"></div>

    <div class="ornement-petit mt-10" aria-hidden="true"><span></span></div>
  </div>
</div>

<script>
  // ENVOYER UN MESSAGE : ce script tourne dans le navigateur du visiteur
  import PocketBase from 'pocketbase'

  const pb = new PocketBase(import.meta.env.PUBLIC_PB_URL || 'http://127.0.0.1:8090')
  const formulaire = document.querySelector('#formulaire-contact')
  const zoneMessage = document.querySelector('#retour-formulaire')
  const bouton = formulaire.querySelector('button[type="submit"]')

  formulaire.addEventListener('submit', async (evenement) => {
    // Empêche le rechargement de la page
    evenement.preventDefault()

    // Récupère les valeurs des champs grâce à leur attribut "name"
    const donnees = Object.fromEntries(new FormData(formulaire))

    bouton.disabled = true
    bouton.textContent = 'ENVOI…'

    try {
      await pb.collection('messages').create(donnees)
      zoneMessage.className = 'alert alert-success mt-6'
      zoneMessage.textContent = 'Merci ! Votre message a bien été envoyé, je vous réponds rapidement.'
      formulaire.reset()
    } catch (erreur) {
      console.error(erreur)
      zoneMessage.className = 'alert alert-error mt-6'
      zoneMessage.textContent = "Oups, le message n'a pas pu être envoyé. Vous pouvez m'écrire directement à alexandreguillet45@gmail.com."
    }

    bouton.disabled = false
    bouton.textContent = 'ENVOYER'
  })
</script>
